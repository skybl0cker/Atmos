<?xml version="1.0" encoding="utf-8"?>
<!-- Tall and narrow (2x3, 2x4 and similar): now + the next four days
     (today's high / low is already under the temperature). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_scene_day_tall" />

    <ImageView
        android:id="@+id/fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_wash"
        android:tint="@color/widget_tint_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/place"
                style="@style/WidgetText.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your city"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_sun_l" />
        </LinearLayout>

        <TextView
            android:id="@+id/temp"
            style="@style/WidgetText.Temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="68°"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/condition"
            style="@style/WidgetText.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="It's Sunny"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hilo"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="H 72°  L 54°"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/day0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day0_name"
                    style="@style/WidgetText.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/day0_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wx_sun_l" />

                <TextView
                    android:id="@+id/day0_lo"
                    style="@style/WidgetText"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="54°"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/day0_hi"
                    style="@style/WidgetText.Medium"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="72°"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/day1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day1_name"
                    style="@style/WidgetText.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fri"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/day1_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wx_partly_day_l" />

                <TextView
                    android:id="@+id/day1_lo"
                    style="@style/WidgetText"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="55°"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/day1_hi"
                    style="@style/WidgetText.Medium"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="75°"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/day2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day2_name"
                    style="@style/WidgetText.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sat"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/day2_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wx_rain_l" />

                <TextView
                    android:id="@+id/day2_lo"
                    style="@style/WidgetText"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="48°"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/day2_hi"
                    style="@style/WidgetText.Medium"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="64°"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/day3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day3_name"
                    style="@style/WidgetText.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sun"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/day3_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wx_cloud_l" />

                <TextView
                    android:id="@+id/day3_lo"
                    style="@style/WidgetText"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="46°"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/day3_hi"
                    style="@style/WidgetText.Medium"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="61°"
                    android:textSize="13sp" />
            </LinearLayout>        </LinearLayout>    </LinearLayout>
</FrameLayout>
