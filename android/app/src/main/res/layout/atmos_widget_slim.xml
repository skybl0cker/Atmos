<?xml version="1.0" encoding="utf-8"?>
<!-- One row (4x1 and similar). Every widget layout shares the four
     background layers (bg / fill / shade / wash) and the ids place, icon,
     temp, condition, hilo; AtmosWidgetProvider sets them for each style. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_scene_day_wide" />

    <ImageView
        android:id="@+id/fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_wash"
        android:tint="@color/widget_tint_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/wx_sun_l" />

        <TextView
            android:id="@+id/temp"
            style="@style/WidgetText.Temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="68°"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/condition"
                style="@style/WidgetText.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="It's Sunny"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/place"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Your city"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hilo"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="H 72°  L 54°"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
